{
  "manifestVersion": 1,
  "id": "ggshield-ado-private-extension",
  "name": "ggshield for Azure Pipelines",
  "version": "0.2.1",
  "publisher": "REPLACE-WITH-YOUR-PUBLISHER-ID",
  "public": false,
  "description": "Private extension that injects ggshield secret scanning into every pipeline in your Azure DevOps organization. Credentials are read from a Generic service connection.",
  "categories": ["Azure Pipelines"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "files": [
    { "path": "ggshield-scan-task" },
    { "path": "decorator/ggshield-decorator.yml", "addressable": true, "contentType": "text/plain" },
    { "path": "images/extension-icon.png", "addressable": true }
  ],
  "contributions": [
    {
      "id": "ggshield-scan-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "ggshield-scan-task"
      }
    },
    {
      "id": "ggshield-decorator",
      "type": "ms.azure-pipelines.pipeline-decorator",
      "targets": ["ms.azure-pipelines-agent-job.post-checkout-tasks"],
      "properties": {
        "template": "decorator/ggshield-decorator.yml"
      }
    }
  ]
}
