{
  "manifestVersion": 1,
  "id": "ggshield-azure-devops",
  "name": "ggshield for Azure Pipelines",
  "version": "0.3.0",
  "publisher": "gitguardian-secret-security",
  "public": false,
  "description": "Azure DevOps extension that injects ggshield secret scanning into every pipeline in your Azure DevOps organization. Credentials are read from a Generic service connection.",
  "categories": ["Azure Pipelines"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "files": [
    { "path": "dist" },
    {
      "path": "decorator/ggshield-decorator.yml",
      "addressable": true,
      "contentType": "text/plain"
    },
    { "path": "images/extension-icon.png", "addressable": true }
  ],
  "contributions": [
    {
      "id": "ggshield-scan-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "dist"
      }
    },
    {
      "id": "ggshield-decorator",
      "type": "ms.azure-pipelines.pipeline-decorator",
      "targets": ["ms.azure-pipelines-agent-job.post-checkout-tasks"],
      "properties": {
        "template": "decorator/ggshield-decorator.yml"
      }
    }
  ]
}
