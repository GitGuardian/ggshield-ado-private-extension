    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "sigstore": "^3.1.0",
    "typescript-eslint": "^8.64.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "shelljs": "0.10.0"
